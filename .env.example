# Analytics (replace with real values)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_YANDEX_METRICA_ID=XXXXXXXX
NEXT_PUBLIC_VK_PIXEL_ID=VK-RTRG-XXXXXX-XXXX

# Admin password (change in production!)
ADMIN_PASSWORD=admin123

# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/podnebesnaya
# Vercel: provided by Vercel Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/podnebesnaya"

# App URL
NEXT_PUBLIC_APP_URL=https://podnebesnaya.ru

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Email (Resend)
# RESEND_API_KEY: create in Resend dashboard.
# EMAIL_FROM: MUST use a domain verified in Resend. Shared domains like *.vercel.app
# are NOT accepted by Resend. Verify your own domain (e.g. podnebesnaya.ru) and set
# "Поднебесная <noreply@yourdomain.com>". Leave empty in production to disable
# email sending until a domain is verified (app will log a warning instead).
RESEND_API_KEY=
EMAIL_FROM=Поднебесная <noreply@yourdomain.com>
